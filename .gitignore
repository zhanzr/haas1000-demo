# ===== Build outputs (generated by scons / aostools) =====
# POLICY: never commit built artifacts (.bin/.hex/.elf/.map). The only
# binary files tracked in this repo are the upstream AliOS Things
# pre-built files that cannot be rebuilt from source (chip prebuild/
# images and the flashing tools' programmer .bin under hardware/chip/).
haas100/solutions/*/out/
haas100/solutions/*/aos_sdk/
haas100/solutions/*/binary/
haas100/solutions/*/.sconsign.dblite
haas100/solutions/*/aos.elf
haas100/solutions/*/aos.map
haas100/solutions/*/*.o
haas100/solutions/*/*.d
haas100/solutions/*/*.hex
haas100/solutions/*/*.bin
haas100/solutions/*/*.elf

# aostools generated files inside the vendored SDK
haas100/**/SConscript
haas100/hardware/chip/haas1000/macro_defines.h
haas100/hardware/chip/haas1000/_haas1000_alios.lds

# generated flash image copies (produced by the post-build step)
haas100/hardware/chip/haas1000/release/release_bin/
haas100/hardware/chip/haas1000/release/write_flash_tool/ota_bin/
haas100/hardware/chip/haas1000/release/write_flash_gui/ota_bin/
haas100/hardware/chip/haas1000/prebuild/littlefs.bin

# aos workspace caches
haas100/.config
haas100/.config_burn
haas100/.config_monitor
haas100/.components.db

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
wifi_config.h
