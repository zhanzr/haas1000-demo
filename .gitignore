haas100/hardware/chip/haas1000/release/write_flash_tool/ota_bin/
haas100/hardware/chip/haas1000/release/write_flash_gui/ota_bin/
haas100/hardware/chip/haas1000/prebuild/littlefs.bin

# aos workspace caches
haas100/.config
haas100/.config_burn
haas100/.config_monitor
haas100/.components.db

